{
  "name": "TALSA - Publicación Automática PDFs (Drive) + BI (Google Sheets)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "talsa-bi",
        "responseMode": "lastNode",
        "options": {
          "responseData": "allEntries"
        }
      },
      "id": "1a2b3c4d-0001-0001-0001-000000000001",
      "name": "1. Webhook Pipeline Python",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "talsa-bi-webhook"
    },
    {
      "parameters": {
        "fieldToSplitOut": "body.ventas",
        "options": {}
      },
      "id": "1a2b3c4d-0002-0002-0002-000000000002",
      "name": "2. Separar Ventas (Split Out)",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.archivo_pdf_local }}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "1a2b3c4d-0003-0003-0003-000000000003",
      "name": "3. Leer Ficha PDF Local",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "name": "={{ $json.nombre_archivo_pdf }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "list",
          "value": "root",
          "cachedResultName": "/ (Root folder)"
        },
        "options": {}
      },
      "id": "1a2b3c4d-0004-0004-0004-000000000004",
      "name": "4. Subir PDF a Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id_venta": "={{ $('2. Separar Ventas (Split Out)').item.json.id_venta }}",
            "id_cliente": "={{ $('2. Separar Ventas (Split Out)').item.json.id_cliente }}",
            "empresa": "={{ $('2. Separar Ventas (Split Out)').item.json.empresa }}",
            "industria": "={{ $('2. Separar Ventas (Split Out)').item.json.industria }}",
            "equipo_comprado": "={{ $('2. Separar Ventas (Split Out)').item.json.equipo_comprado }}",
            "tipo_equipo": "={{ $('2. Separar Ventas (Split Out)').item.json.tipo_equipo }}",
            "codigo_modelo": "={{ $('2. Separar Ventas (Split Out)').item.json.codigo_modelo }}",
            "fecha_venta": "={{ $('2. Separar Ventas (Split Out)').item.json.fecha_venta }}",
            "monto_usd": "={{ $('2. Separar Ventas (Split Out)').item.json.monto_usd }}",
            "ciudad": "={{ $('2. Separar Ventas (Split Out)').item.json.ciudad }}",
            "departamento": "={{ $('2. Separar Ventas (Split Out)').item.json.departamento }}",
            "pais": "={{ $('2. Separar Ventas (Split Out)').item.json.pais }}",
            "origen_analisis": "={{ $('2. Separar Ventas (Split Out)').item.json.origen_analisis }}",
            "score_compatibilidad": "={{ $('2. Separar Ventas (Split Out)').item.json.score_compatibilidad }}",
            "complejidad_tecnica": "={{ $('2. Separar Ventas (Split Out)').item.json.complejidad_tecnica }}",
            "justificacion_score": "={{ $('2. Separar Ventas (Split Out)').item.json.justificacion_score }}",
            "resumen_casos_uso": "={{ $('2. Separar Ventas (Split Out)').item.json.resumen_casos_uso }}",
            "resumen_recomendaciones": "={{ $('2. Separar Ventas (Split Out)').item.json.resumen_recomendaciones }}",
            "archivo_ficha_pdf": "={{ $json.webViewLink }}"
          },
          "matchingColumns": [
            "id_venta"
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0005-0005-0005-000000000005",
      "name": "5. Actualizar Google Sheets (Looker Studio)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1120,
        300
      ]
    }
  ],
  "connections": {
    "1. Webhook Pipeline Python": {
      "main": [
        [
          {
            "node": "2. Separar Ventas (Split Out)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Separar Ventas (Split Out)": {
      "main": [
        [
          {
            "node": "3. Leer Ficha PDF Local",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. Leer Ficha PDF Local": {
      "main": [
        [
          {
            "node": "4. Subir PDF a Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "4. Subir PDF a Google Drive": {
      "main": [
        [
          {
            "node": "5. Actualizar Google Sheets (Looker Studio)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
